{
    "out_dir": "/path/scratch/out",
    "ref_dir": "/path/scratch/ref",
    "image_dir": "/path/scratch/images",
    "pre_script": "module load singularity; export SINGULARITYENV_REF_PATH=\"...\"",
    "post_script": "",
    "singularity_flags": "--cleanenv --no-home --bind /path/scratch/:/path/scratch",
    "build": "GRCh38_full_analysis_set_plus_decoy_hla",
    "caveman_step_jobs": 10,
    "mapping": false,
    "images": {
        "pcap-core": {"url": "docker://quay.io/wtsicgp/pcap-core",          "version": "5.6.1"},
        "pindel":    {"url": "docker://quay.io/wtsicgp/cgppindel",          "version": "3.11.1"},
        "caveman":   {"url": "docker://quay.io/wtsicgp/cgpcavemanwrapper",  "version": "1.18.2"},
        "brass":     {"url": "docker://quay.io/wtsicgp/brass",              "version": "v6.3.4"},
        "ascat":     {"url": "docker://quay.io/wtsicgp/ascatngs",           "version": "4.5.0"},
        "vagrent":   {"url": "docker://quay.io/wtsicgp/vagrent",            "version": "v3.7.0"}
    },
    "options": {
        "default":          {"cores": 1,    "memory": "2GB",    "queue": "normal"},
        "bwa_mem":          {"cores": 8,    "memory": "64GB",   "queue": "long"},
        "ascat":            {"cores": 1,    "memory": "8GB",    "queue": "normal"},
