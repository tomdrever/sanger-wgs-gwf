        "caveman_flag":     {"cores": 24,   "memory": "16GB",   "queue": "long"},
        "pindel":           {"cores": 8,    "memory": "100GB",  "queue": "long"},
        "brass_input":      {"cores": 2,    "memory": "12GB",   "queue": "long"},
        "brass_cover":      {"cores": 1,    "memory": "8GB",    "queue": "long"},
        "brass_main":       {"cores": 4,    "memory": "32GB",   "queue": "long"},
        "vagrent":          {"cores": 1,    "memory": "8GB",    "queue": "normal"}
    }
}
